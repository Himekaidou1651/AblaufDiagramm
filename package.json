{
  "name": "ablaufdiagramm-elec",
  "version": "2.0.0",
  "description": "AblaufDiagramm desktop flowchart editor",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "package:win": "electron-builder --win portable",
    "build:desktop": "npm run build:web && npm run package:win",
    "test": "node scripts/run-tests.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himekaidou1651/AblaufDiagramm-elec.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Himekaidou1651/AblaufDiagramm-elec/issues"
  },
  "homepage": "https://github.com/Himekaidou1651/AblaufDiagramm-elec#readme",
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^44.4.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "html-to-image": "^1.11.13",
    "markdown-it": "^14.1.0",
    "pinia": "^2.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.2.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "build": {
    "appId": "com.ablaufdiagramm.elec",
    "productName": "AD",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "public/vite.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AD.exe"
    }
  }
}
